    },
    {
      "name": "Moses Adewale",
      "email": "adewale.moses.b@gmail.com",
      "homepage": "https://github.com/mosesadewale"
    }
  ],
  "homepage": "https://github.com/monnify/monnify-laravel",
  "keywords": [
    "Laravel",
    "Monnify-laravel",
    "Payment Gateway",
    "Monnify"
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/validation": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Monnify\\MonnifyLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Monnify\\MonnifyLaravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Monnify\\MonnifyLaravel\\MonnifyServiceProvider"
      ],
      "aliases": {
        "Monnify": "Monnify\\MonnifyLaravel\\Facades\\Monnify"
      }
    }
  },
  "require-dev": {
    "orchestra/testbench": "^8.34|^9.0|^10.0|^11.0",
    "phpstan/phpstan": "^2.0"
  }
}
