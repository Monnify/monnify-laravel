{
  "name": "monnify/monnify-laravel",
  "description": "A Laravel Monnify Package",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Babatunde Adelabu",
      "email": "adelabu4fred@gmail.com",
      "homepage": "https://github.com/fredneutron"
    },
